{
  "id": "kcuckoounter",
  "description": "Card-counting trainer with Qt, KDE, and touch-first profiles.",
  "version": "1.0.0",
  "cpp_standard": 20,
  "android_application_id": "org.ninjaro.kcuckoounter",
  "android": {
    "name": "Kcuckoounter",
    "version_code": 1,
    "min_sdk": 28,
    "excluded_permissions": [
      "android.permission.ACCESS_NETWORK_STATE",
      "android.permission.INTERNET",
      "android.permission.WRITE_EXTERNAL_STORAGE"
    ],
    "allow_backup": false,
    "full_backup_only": false,
    "supports_rtl": true,
    "icon": "assets/brand/logo.svg"
  },
  "install_assets": true,
  "facade": "trainer_app:app",
  "artifacts": [
    {
      "id": "watchdog_client:client",
      "kind": "static_lib",
      "owns": [],
      "packages": {
        "external_project": {
          "repository": "https://github.com/ninjaro/peepbooth",
          "revision": "master",
          "package": "monitor",
          "artifact": "watchdog_client:client"
        }
      },
      "name": "monitor_watchdog_client"
    },
    {
      "id": "watchdog_qt:qt",
      "kind": "static_lib",
      "owns": [],
      "packages": {
        "external_project": {
          "repository": "https://github.com/ninjaro/peepbooth",
          "revision": "master",
          "package": "monitor",
          "artifact": "watchdog_qt:qt"
        }
      },
      "name": "monitor_watchdog_qt"
    },
    {
      "id": "packing_library:core",
      "kind": "static_lib",
      "owns": [],
      "packages": {
        "external_project": {
          "repository": "https://github.com/ninjaro/rothko",
          "revision": "master",
          "package": "packing",
          "artifact": "library:core"
        }
      },
      "name": "packing_core"
    },
    {
      "id": "trainer_app:core",
      "kind": "static_lib",
      "name": "kcuckoounter_core",
      "root": "app",
      "owns": [
        "include/arch",
        "src/arch",
        "include/card_helpers",
        "src/card_helpers",
        "include/image",
        "src/image",
        "include/settings",
        "src/settings",
        "include/shell",
        "src/shell",
        "include/table",
        "src/table"
      ],
      "dependencies": [
        "watchdog_client:client",
        "packing_library:core"
      ],
      "packages": {
        "qt": [
          "Core",
          "Concurrent",
          "Svg",
          "Widgets"
        ],
        "kde": [
          "CoreAddons",
          "I18n",
          "XmlGui",
          "ConfigWidgets",
          "WidgetsAddons",
          "KDEGames6"
        ]
      }
    },
    {
      "id": "trainer_app:app",
      "kind": "qt_app",
      "name": "kcuckoounter",
      "root": "app",
      "owns": [
        "src/cli/main.cpp"
      ],
      "entry": "src/cli/main.cpp",
      "dependencies": [
        "trainer_app:core",
        "watchdog_qt:qt"
      ],
      "packages": {
        "qt": [
          "Core",
          "Concurrent",
          "Svg",
          "Widgets"
        ],
        "kde": [
          "CoreAddons",
          "I18n",
          "XmlGui",
          "ConfigWidgets",
          "WidgetsAddons",
          "KDEGames6"
        ],
        "android": [
          "qt_android"
        ]
      }
    },
    {
      "id": "trainer_app:tests",
      "kind": "qt_app",
      "name": "kcuckoounter_tests",
      "root": "app",
      "owns": [
        "tests"
      ],
      "entry": "tests/main_tests.cpp",
      "dependencies": [
        "trainer_app:core"
      ],
      "packages": {
        "qt": [
          "Test"
        ]
      },
      "tests": {
        "qttest": true
      }
    }
  ]
}
